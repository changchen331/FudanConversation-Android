<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 右侧按钮切换 -->
    <!--  当按钮被禁用时  -->
    <item android:drawable="@drawable/switch_right_locked" android:state_enabled="false" />

    <!-- 当按钮未被激活时 -->
    <item android:drawable="@drawable/switch_right_cancel" android:state_activated="false" />

    <!-- 当按钮被激活时 -->
    <item android:drawable="@drawable/switch_right_send" android:state_activated="true" />

</selector>